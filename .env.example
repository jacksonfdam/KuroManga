# Postgres
POSTGRES_USER=manga
POSTGRES_PASSWORD=change-me
POSTGRES_DB=manga
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# File ownership shared between worker and komga
PUID=1000
PGID=1000

# Library
LIBRARY_PATH=/manga
DOWNLOAD_CONCURRENCY=3

# Komga
# An API key is the normal way in: Settings -> Account -> API keys in Komga.
# User and password are only needed once, to claim a brand new instance that has
# no user yet (no user means no key can exist). Bootstrap claims it for you.
KOMGA_URL=http://komga:25600
KOMGA_API_KEY=
KOMGA_USER=
KOMGA_PASS=
KOMGA_API_KEY=
KOMGA_LIBRARY_NAME=Manga

# MyAnimeList OAuth2 PKCE - https://myanimelist.net/apiconfig
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=

# AniList OAuth2 - https://anilist.co/settings/developer
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# Public base URL used to build OAuth redirect URIs
PUBLIC_BASE_URL=http://localhost:8080
