# Postgres
POSTGRES_USER=manga
POSTGRES_PASSWORD=change-me
POSTGRES_DB=manga
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# File ownership shared between worker and komga
PUID=1000
PGID=1000

# Library
LIBRARY_PATH=/manga
DOWNLOAD_CONCURRENCY=3

# Komga
# An API key is the normal way in: Settings -> Account -> API keys in Komga.
# User and password are only needed once, to claim a brand new instance that has
# no user yet (no user means no key can exist). Bootstrap claims it for you.
KOMGA_URL=http://komga:25600
KOMGA_API_KEY=
KOMGA_USER=
KOMGA_PASS=
KOMGA_API_KEY=
KOMGA_LIBRARY_NAME=Manga

# MyAnimeList OAuth2 PKCE - https://myanimelist.net/apiconfig
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=

# AniList OAuth2 - https://anilist.co/settings/developer
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# MangaDex personal client - https://mangadex.org/settings#api-clients
# Optional. Search and chapter listing work anonymously, and MangaDex caches
# anonymous responses but not authenticated ones, so leave these empty unless
# you need them. It is an OAuth client, not a single key: all four are required.
MANGADEX_CLIENT_ID=
MANGADEX_CLIENT_SECRET=
MANGADEX_USERNAME=
MANGADEX_PASSWORD=

# Public base URL used to build OAuth redirect URIs
PUBLIC_BASE_URL=http://localhost:8080

# Bundled comick-source-api scraper, used for discovery search and chapter listing
COMICK_API_URL=http://comick:3000
